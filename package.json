{
  "name": "volam-hero-defense",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "pnpm build:shared && concurrently --kill-others --names shared,server,client \"tsc -b packages/game-core packages/game-data packages/game-protocol --watch --preserveWatchOutput\" \"pnpm --filter @volam/game-server dev\" \"pnpm --filter @volam/game-client dev\"",
    "build:shared": "pnpm assets:prepare && tsc -b packages/game-core packages/game-data packages/game-protocol",
    "build": "pnpm assets:prepare && tsc -b && pnpm --filter @volam/game-client build",
    "typecheck": "pnpm assets:prepare && tsc -b && tsc -p tsconfig.tools.json --noEmit",
    "test": "pnpm build:shared && vitest run",
    "test:watch": "pnpm build:shared && vitest",
    "test:e2e": "pnpm build && node tools/run-playwright.mjs test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:handoff": "python scripts/verify_handoff.py",
    "install:browsers": "node tools/run-playwright.mjs install chromium",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:generate": "python assets/source/m1_art.py && python assets/source/ui_world.py",
    "test:balance": "pnpm build:shared && pnpm --filter @volam/game-server exec tsx ../../tools/m1-balance.ts",
    "verify:assets": "python scripts/verify-assets.py"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "@colyseus/sdk": "0.18.8",
    "@colyseus/testing": "0.18.6",
    "@colyseus/tools": "0.18.11",
    "@colyseus/core": "0.18.23",
    "@colyseus/schema": "5.0.42",
    "@colyseus/ws-transport": "0.18.4",
    "@volam/game-core": "workspace:*",
    "@volam/game-data": "workspace:*",
    "@volam/game-protocol": "workspace:*",
    "vite": "8.3.5"
  }
}
