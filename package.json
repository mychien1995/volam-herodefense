{
  "name": "volam-hero-defense",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "pnpm build:shared && concurrently --kill-others --names shared,server,client \"tsc -b packages/game-core packages/game-data packages/game-protocol --watch --preserveWatchOutput\" \"pnpm --filter @volam/game-server dev\" \"pnpm --filter @volam/game-client dev\"",
    "build:shared": "pnpm assets:prepare && tsc -b packages/game-core packages/game-data packages/game-protocol",
    "build": "pnpm assets:prepare && tsc -b && pnpm --filter @volam/game-client build",
    "typecheck": "pnpm assets:prepare && tsc -b && tsc -p tsconfig.tools.json --noEmit",
    "test": "pnpm build:shared && vitest run",
    "test:watch": "pnpm build:shared && vitest",
    "test:e2e": "node scripts/check-workflow.mjs browser",
    "test:e2e:invasion": "node scripts/check-workflow.mjs browser --config playwright.invasion.config.ts",
    "test:e2e:skills": "node scripts/check-workflow.mjs browser --config playwright.skills.config.ts",
    "check:quick": "node scripts/check-workflow.mjs quick",
    "check:browser": "node scripts/check-workflow.mjs browser",
    "check:art:frames": "node scripts/check-arena-creep-frames.mjs",
    "check:final": "node scripts/check-workflow.mjs final",
    "test:workflow": "node --test scripts/tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:handoff": "python scripts/verify_handoff.py",
    "install:browsers": "node tools/run-playwright.mjs install chromium",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:generate": "python assets/source/m1_art.py && python assets/source/ui_world.py",
    "test:balance": "pnpm build:shared && pnpm --filter @volam/game-server exec tsx ../../tools/m1-balance.ts",
    "test:balance:m2b": "pnpm build:shared && pnpm --filter @volam/game-server exec tsx ../../tools/m2b-balance.ts",
    "test:balance:m3a": "pnpm build:shared && pnpm --filter @volam/game-server exec tsx ../../tools/m3a-balance.ts",
    "assets:export:skills": "node assets/source/skills/cai-bang/build.mjs",
    "assets:icons:skills": "python scripts/prepare-skill-assets.py",
    "verify:assets": "python scripts/verify-assets.py && python scripts/verify-arena-art01.py && python scripts/verify-arena-v2.py && python scripts/verify-thien-son.py && python scripts/verify-vo-dang.py && python scripts/verify-thieu-lam.py && python scripts/verify-thieu-lam-skills.py && python scripts/verify-thien-son-skills.py && python scripts/verify-vo-dang-skills.py && python scripts/verify-bamboo-forest.py && python scripts/verify-desert.py && python scripts/verify-forest-creeps.py && python scripts/verify-beach.py && python scripts/verify-hell.py && python scripts/verify-chu-art.py && python scripts/verify-ly-mac-sau.py && python scripts/verify-inventory-ui.py && python scripts/verify-tay-doc.py && python scripts/verify-nam-de.py && python scripts/verify-bac-cai-preview.py && python scripts/verify-vuong-trung-duong.py && python scripts/verify-renovation.py && python scripts/verify-renovation-runtime.py && python scripts/verify-renovation-v2.py && python scripts/verify-renovation-v3.py && python scripts/verify-renovation-v4.py && python scripts/verify-renovation-v5.py && python scripts/verify-renovation-v6.py && python scripts/verify-renovation-v7.py && python scripts/verify-renovation-v8.py && python scripts/verify-loi-dai.py && python scripts/verify-contact-impacts.py",
    "assets:export:arena": "node scripts/export-arena-art01.mjs",
    "assets:export:visual": "node scripts/export-arena-v2.mjs",
    "assets:export:thien-son": "node scripts/export-thien-son.mjs",
    "assets:export:vo-dang": "node scripts/export-vo-dang.mjs",
    "assets:export:thieu-lam": "node scripts/export-thieu-lam.mjs",
    "test:e2e:progression": "node scripts/check-workflow.mjs browser --config playwright.progression.config.ts tests/e2e/progression.spec.ts",
    "test:balance:m3b": "pnpm build:shared && pnpm --filter @volam/game-server exec tsx ../../tools/m3b-balance.ts",
    "assets:export:thien-son-skills": "node assets/source/skills/thien-son/build_v01.mjs && node assets/source/skills/thien-son/build_icons_v01.mjs",
    "assets:export:thieu-lam-skills": "python assets/source/skills/thieu-lam/prepare.py && node assets/source/skills/thieu-lam/build.mjs --assemble",
    "assets:export:bamboo": "node scripts/export-bamboo-forest.mjs",
    "assets:verify:bamboo": "python scripts/verify-bamboo-forest.py",
    "assets:export:inventory-ui": "python scripts/export-inventory-ui.py",
    "dev:tay-doc": "pnpm assets:prepare && tsc -b apps/game-server && pnpm --filter @volam/game-server exec tsx ../../tools/tay-doc-dev.ts",
    "test:balance:nam-de": "pnpm build:shared && pnpm --filter @volam/game-server exec tsx ../../tools/nam-de-balance.ts",
    "assets:export:renovation": "node scripts/export-renovation.mjs",
    "assets:export:renovation-runtime": "node scripts/export-renovation-runtime.mjs",
    "dev:renovation": "node tools/renovation-dev.mjs",
    "assets:export:renovation-v2": "node scripts/export-renovation-v2.mjs",
    "dev:renovation:skills": "node tools/renovation-skills-dev.mjs",
    "assets:export:renovation-v3": "node scripts/export-renovation-v3.mjs",
    "assets:export:renovation-v4": "node scripts/export-renovation-v4.mjs",
    "assets:export:renovation-v5": "node scripts/export-renovation-v5.mjs",
    "dev:renovation:bosses": "node tools/renovation-wave-bosses-dev.mjs",
    "assets:export:renovation-v6": "node scripts/export-renovation-v6.mjs",
    "assets:export:renovation-v7": "node scripts/export-renovation-v7.mjs",
    "assets:export:renovation-v8": "node scripts/export-renovation-v8.mjs",
    "qa:preflight": "node tools/qa-preflight.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "@colyseus/sdk": "0.18.8",
    "@colyseus/testing": "0.18.6",
    "@colyseus/tools": "0.18.11",
    "@colyseus/core": "0.18.23",
    "@colyseus/schema": "5.0.42",
    "@colyseus/ws-transport": "0.18.4",
    "@volam/game-core": "workspace:*",
    "@volam/game-data": "workspace:*",
    "@volam/game-protocol": "workspace:*",
    "vite": "8.3.5"
  }
}
