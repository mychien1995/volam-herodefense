{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "dist/types",
    "lib": ["ES2022", "DOM"],
    "types": ["vite/client"],
    "emitDeclarationOnly": true
  },
  "references": [
    {
      "path": "../../packages/game-data"
    },
    {
      "path": "../../packages/game-protocol"
    },
    {
      "path": "../game-server"
    }
  ],
  "include": ["src/**/*.ts", "src/**/*.json"]
}
